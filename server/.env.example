# Salin jadi .env, lalu isi. JANGAN commit .env.

# Hanya dengarkan localhost — TLS dan akses publik ditangani nginx di depannya.
# Mengubah ini ke 0.0.0.0 berarti server terbuka tanpa TLS; jangan.
PM_HOST=127.0.0.1
PM_PORT=8787

# File SQLite. Backup = menyalin file ini (plus -wal dan -shm bila ada).
PM_DB=/var/lib/project-memory/memory.db

# Peta token ke nama penulis: "nama:token,nama:token".
# Nama inilah yang tercatat sebagai author tiap entri, jadi pakai nama orang,
# bukan nama layanan. Satu token per orang — token bersama membuat kolom author
# tidak ada gunanya.
# Buat token dengan: openssl rand -hex 32
PM_TOKENS=usep:GANTI_DENGAN_TOKEN_ACAK,rafi:GANTI_DENGAN_TOKEN_ACAK
