# Salin jadi .env, lalu isi. JANGAN commit .env.

# Hanya dengarkan localhost — TLS dan akses publik ditangani nginx di depannya.
# Mengubah ini ke 0.0.0.0 berarti server terbuka tanpa TLS; jangan.
PM_HOST=127.0.0.1
PM_PORT=8787

# File SQLite. Backup = menyalin file ini (plus -wal dan -shm bila ada).
PM_DB=/var/lib/project-memory/memory.db

# Penyemaian pengguna pertama saja, dalam bentuk "nama:token,nama:token".
# Hanya berlaku selagi tabel users masih kosong; yang pertama jadi admin.
# Setelah ada pengguna, database yang jadi sumber kebenaran dan baris ini
# diabaikan — supaya env var lama tidak bisa menghidupkan kembali akses yang
# sudah dicabut lewat GUI.
#
# Disarankan mengosongkannya dan membuat admin pertama lewat CLI:
#   node src/admin.mjs add <nama> --admin
PM_TOKENS=

# Umur (hari) sebuah entri sebelum ditandai "PERIKSA ULANG" di setiap briefing.
# Bukan karena fakta jadi salah pada hari ke-N, tapi karena setelah kira-kira
# satu kuartal biasanya sudah ada refactor, perpindahan modul, atau pergantian
# konvensi setidaknya sekali. Kosongkan untuk memakai default 120.
PM_STALE_DAYS=120
