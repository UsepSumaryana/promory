# Config awal, HTTP saja. JANGAN menambahkan blok 443 secara manual di sini.
#
# Kenapa: blok 443 harus menunjuk file sertifikat, sementara sertifikatnya baru
# ada setelah certbot berhasil dijalankan — dan certbot butuh nginx yang bisa
# start lebih dulu. Menulis blok 443 duluan membuat `nginx -t` gagal dengan
# "cannot load certificate ... no such file", dan certbot tidak pernah jalan.
#
# Alur yang benar:
#   1. ganti memory.example.com di bawah dengan domain Anda
#   2. sudo nginx -t && sudo systemctl reload nginx
#   3. sudo certbot --nginx -d <domain-anda>
#
# Certbot menyisipkan sendiri blok 443 lengkap dengan path sertifikat dan
# pengalihan dari 80, memakai sintaks yang cocok untuk versi nginx Anda.

server {
    listen 80;
    server_name memory.example.com;

    location /mcp {
        proxy_pass http://127.0.0.1:8787/;
        proxy_http_version 1.1;

        # Transport MCP boleh menjawab sebagai SSE. Tanpa mematikan buffering,
        # jawaban streaming tertahan di nginx dan klien tampak menggantung.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization $http_authorization;
    }

    # GUI admin dan API-nya. Halaman /ui sendiri hanya kerangka kosong; semua
    # data lewat /api yang menuntut token ber-peran admin.
    location ~ ^/(ui|api)/? {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Authorization $http_authorization;

        # Lapisan kedua opsional: batasi GUI ke jaringan kantor atau VPN.
        # Peran admin sudah menjaga datanya, tapi mempersempit siapa yang bisa
        # menjangkau halaman ini mengurangi permukaan serangan tanpa biaya.
        # allow 10.0.0.0/8;
        # deny all;
    }

    # Briefing recall untuk SessionStart hook. Wajib diteruskan — tanpa ini
    # hook tidak pernah mendapat memory dan sesi berjalan tanpa recall.
    location /brief {
        proxy_pass http://127.0.0.1:8787/brief;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    # Retrieval per-prompt (POST). Wajib diteruskan — tanpa ini hook
    # UserPromptSubmit tidak pernah mendapat entri relevan.
    location /relevant {
        proxy_pass http://127.0.0.1:8787/relevant;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location /health {
        proxy_pass http://127.0.0.1:8787/health;
    }
}
